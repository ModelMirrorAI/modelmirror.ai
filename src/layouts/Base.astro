---
import "../styles/global.css";
const { title, description = "ModelMirror evaluates frontier AI models on forward predictions about the real world." } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const fullTitle = path === "/" ? "ModelMirror" : `${title} — ModelMirror`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131419" media="(prefers-color-scheme: dark)" />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href="/">ModelMirror</a>
        <nav aria-label="Site">
          <a href="https://fedcourts.ai">FedCourtsAI</a>
          <a href="https://github.com/ModelMirrorAI">GitHub</a>
        </nav>
      </div>
    </header>
    <main><div class="wrap"><slot /></div></main>
    <footer class="site-foot">
      <div class="wrap">
        <p>Model Mirror LLC. Project outputs are experimental model predictions and are not advice of any kind.</p>
        <p>
          <a href="https://github.com/ModelMirrorAI">GitHub</a> ·
          <a href="https://x.com/ModelMirrorAI">@ModelMirrorAI</a> ·
          <a href="/privacy">Privacy</a> ·
          <a href="/terms">Terms</a>
        </p>
      </div>
    </footer>
    <!-- Cloudflare Web Analytics beacon goes here once the site is connected. -->
  </body>
</html>
